# Copy this file to `.env` and fill in real values for local development.
# In production, set the same names in EAS Secrets:
#   eas secret:create --name GOOGLE_MAPS_API_KEY --value <key>
#   eas secret:create --name SENTRY_DSN --value <dsn>

# Google Maps Static + Geocoding API key.
# Restrict in GCP Console to:
#   - Application restriction: iOS + Android bundle id `com.roofinspector.app`
#   - API restriction: Maps Static API, Geocoding API
GOOGLE_MAPS_API_KEY=

# Optional. Get from https://sentry.io > Project > Settings > Client Keys (DSN)
SENTRY_DSN=

# ─── Cloud Sync (Sprint F, optional) ─────────────────────────────────────────
# Create a Supabase project at https://supabase.com and copy the values from
# Project Settings > API. Both vars must be present to enable sign-in and sync.
# When blank, the app runs in offline-only mode (default).
SUPABASE_URL=
SUPABASE_ANON_KEY=
